generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String           @id @default(cuid())
  name          String
  email         String           @unique
  password      String
  role          Role             @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  passwordResets PasswordReset[]

  @@map("users")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

model Client {
  id                String         @id @default(cuid())
  axonautId         Int?           @unique
  name              String
  email             String?
  phone             String?
  mobile            String?
  fax               String?
  website           String?
  siret             String?
  address           String?
  addressComplement String?
  city              String?
  zipCode           String?
  country           String?
  clientType        String?
  notes             String?
  logoUrl           String?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  invoices          Invoice[]
  installations     Installation[]
  portalUsers       ClientUser[]
  portalSettings    ClientPortalSettings?
  contacts          Contact[]
  boardCards        BoardCard[]

  @@index([deletedAt])
  @@map("clients")
}

model ClientUser {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  email             String    @unique
  password          String    @default("")
  active            Boolean   @default(true)
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clientId])
  @@index([inviteToken])
  @@map("client_users")
}

model Contact {
  id                 String   @id @default(cuid())
  axonautId          Int?     @unique
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  mobile             String?
  jobTitle           String?
  isBillingContact   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([clientId])
  @@map("contacts")
}

model ClientPortalSettings {
  id              String  @id @default(cuid())
  clientId        String  @unique
  client          Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  primaryColor    String  @default("#3b82f6")
  headerLogo      String?
  welcomeMessage  String?
  welcomeTitle    String?
  welcomeContent  String?
  showStats       Boolean @default(true)
  showExpiring    Boolean @default(true)
  showFamily      Boolean @default(true)
  showSupplier    Boolean @default(true)
  showDuration    Boolean @default(true)
  showQuantity    Boolean @default(false)
  showComParc     Boolean @default(false)
  footerText      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("client_portal_settings")
}

model Product {
  id              String         @id @default(cuid())
  axonautId       Int?           @unique
  name            String
  code            String?
  description     String?
  family          String?
  supplier        String?
  duration        String?
  durationMonths  Int?
  unitPrice       Float?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  invoiceLines    InvoiceLine[]
  installations   Installation[]

  @@index([deletedAt])
  @@map("products")
}

model Invoice {
  id              String        @id @default(cuid())
  axonautId       Int?          @unique
  invoiceNumber   String?
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  invoiceDate     DateTime
  totalAmount     Float?
  status          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           InvoiceLine[]
  installations   Installation[]

  @@map("invoices")
}

model InvoiceLine {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  description     String?
  quantity        Float         @default(1)
  unitPrice       Float?
  purchasePrice   Float?
  totalPrice      Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("invoice_lines")
}

model Installation {
  id              String             @id @default(cuid())
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id])
  productId       String
  product         Product            @relation(fields: [productId], references: [id])
  invoiceId       String?
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id])
  invoiceLineId   String?            @unique
  supplier        String?
  family          String?
  quantity        Float              @default(1)
  startDate       DateTime
  durationMonths  Int
  endDate         DateTime
  status          String             @default("EN_PARC_GARANTIE")
  alwaysInFleet   Boolean            @default(false)
  comParc         String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  history         InstallationHistory[]

  deletedAt       DateTime?
  @@index([clientId])
  @@index([status])
  @@index([endDate])
  @@index([status, endDate])
  @@index([deletedAt])
  @@map("installations")
}

model InstallationHistory {
  id              String       @id @default(cuid())
  installationId  String
  installation    Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  field           String
  oldValue        String?
  newValue        String?
  changedBy       String?
  createdAt       DateTime     @default(now())

  @@index([installationId])
  @@map("installation_history")
}

model SyncLog {
  id          String   @id @default(cuid())
  type        String
  status      String
  message     String?
  details     String?
  itemCount   Int      @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@map("sync_logs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String   // CREATE, UPDATE, DELETE, RESTORE, LOGIN, LOGOUT, EXPORT, SYNC, BULK_DELETE, BULK_UPDATE
  entity     String   // client, product, installation, invoice, user, settings
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

// ─── Tableau de communication (Board) ───────────────────────────

model BoardColumn {
  id        String      @id @default(cuid())
  name      String
  color     String      @default("#3b82f6")
  position  Int         @default(0)
  cards     BoardCard[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("board_columns")
}

model BoardCard {
  id          String           @id @default(cuid())
  columnId    String
  column      BoardColumn      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    Int              @default(3) // 1=Urgent, 2=Normal, 3=Basse
  position    Int              @default(0)
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId  String?
  createdById String?
  dueDate     DateTime?
  links       String?          // JSON array of links
  comments    CardComment[]
  attachments CardAttachment[]
  tags        CardTagLink[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([columnId])
  @@index([clientId])
  @@index([assigneeId])
  @@index([priority])
  @@map("board_cards")
}

model CardComment {
  id        String    @id @default(cuid())
  cardId    String
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  content   String
  createdAt DateTime  @default(now())

  @@index([cardId])
  @@map("card_comments")
}

model CardAttachment {
  id        String    @id @default(cuid())
  cardId    String
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int?
  createdAt DateTime  @default(now())

  @@index([cardId])
  @@map("card_attachments")
}

model CardTag {
  id    String        @id @default(cuid())
  name  String        @unique
  color String        @default("#6b7280")
  cards CardTagLink[]

  @@map("card_tags")
}

model CardTagLink {
  id     String    @id @default(cuid())
  cardId String
  card   BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tagId  String
  tag    CardTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([cardId, tagId])
  @@map("card_tag_links")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}
