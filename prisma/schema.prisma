generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String           @id @default(cuid())
  name          String
  email         String           @unique
  password      String
  role          Role             @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  passwordResets PasswordReset[]

  @@map("users")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

model Client {
  id                String         @id @default(cuid())
  axonautId         Int?           @unique
  oxiboxId          String?
  emsisoftId        String?
  name              String
  email             String?
  phone             String?
  mobile            String?
  fax               String?
  website           String?
  siret             String?
  address           String?
  addressComplement String?
  city              String?
  zipCode           String?
  country           String?
  clientType        String?
  notes             String?
  logoUrl           String?
  importSource      String?
  importDetails     String?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  invoices          Invoice[]
  installations     Installation[]
  portalUsers       ClientUser[]
  portalSettings    ClientPortalSettings?
  contacts          Contact[]
  boardCards        BoardCard[]
  tickets           Ticket[]

  @@index([deletedAt])
  @@map("clients")
}

model ClientUser {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  email             String    @unique
  password          String    @default("")
  active            Boolean   @default(true)
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  passwordResets    ClientPasswordReset[]
  tickets           Ticket[]

  @@index([clientId])
  @@index([inviteToken])
  @@map("client_users")
}

model ClientPasswordReset {
  id           String     @id @default(cuid())
  clientUserId String
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  token        String     @unique
  expiresAt    DateTime
  used         Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([token])
  @@index([clientUserId])
  @@map("client_password_resets")
}

model Contact {
  id                 String   @id @default(cuid())
  axonautId          Int?     @unique
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  mobile             String?
  jobTitle           String?
  isBillingContact   Boolean  @default(false)
  importSource       String?
  importDetails      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  boardCards         BoardCard[]

  @@index([clientId])
  @@map("contacts")
}

model ClientPortalSettings {
  id              String  @id @default(cuid())
  clientId        String  @unique
  client          Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  primaryColor    String  @default("#3b82f6")
  headerLogo      String?
  welcomeMessage  String?
  welcomeTitle    String?
  welcomeContent  String?
  showStats       Boolean @default(true)
  showExpiring    Boolean @default(true)
  showFamily      Boolean @default(true)
  showSupplier    Boolean @default(true)
  showDuration    Boolean @default(true)
  showQuantity    Boolean @default(false)
  showComParc     Boolean @default(false)
  showHeaderRow   Boolean @default(true)
  footerText      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("client_portal_settings")
}

model Product {
  id              String         @id @default(cuid())
  axonautId       Int?           @unique
  name            String
  code            String?
  description     String?
  family          String?
  supplier        String?
  duration        String?
  durationMonths  Int?
  unitPrice       Float?
  importSource    String?
  importDetails   String?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  invoiceLines    InvoiceLine[]
  installations   Installation[]

  @@index([deletedAt])
  @@map("products")
}

model Invoice {
  id              String        @id @default(cuid())
  axonautId       Int?          @unique
  invoiceNumber   String?
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  invoiceDate     DateTime
  totalAmount     Float?
  status          String?
  importSource    String?
  importDetails   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           InvoiceLine[]
  installations   Installation[]

  @@index([clientId])
  @@index([invoiceDate])
  @@index([invoiceNumber, clientId])
  @@map("invoices")
}

model InvoiceLine {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  description     String?
  quantity        Float         @default(1)
  unitPrice       Float?
  purchasePrice   Float?
  totalPrice      Float?
  importSource    String?
  importDetails   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_lines")
}

model Installation {
  id              String             @id @default(cuid())
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id])
  productId       String
  product         Product            @relation(fields: [productId], references: [id])
  invoiceId       String?
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id])
  invoiceLineId   String?            @unique
  supplier        String?
  family          String?
  quantity        Float              @default(1)
  startDate       DateTime
  durationMonths  Int
  endDate         DateTime
  status          String             @default("EN_PARC")
  alwaysInFleet   Boolean            @default(false)
  comParc         String?
  notes           String?
  importSource    String?
  importDetails   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  history         InstallationHistory[]

  deletedAt       DateTime?
  @@index([clientId])
  @@index([status])
  @@index([endDate])
  @@index([status, endDate])
  @@index([deletedAt])
  @@map("installations")
}

model InstallationHistory {
  id              String       @id @default(cuid())
  installationId  String
  installation    Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  field           String
  oldValue        String?
  newValue        String?
  changedBy       String?
  createdAt       DateTime     @default(now())

  @@index([installationId])
  @@map("installation_history")
}

model SyncLog {
  id          String   @id @default(cuid())
  type        String
  status      String
  message     String?
  details     String?
  itemCount   Int      @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([type, status])
  @@index([startedAt])
  @@map("sync_logs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String   // CREATE, UPDATE, DELETE, RESTORE, LOGIN, LOGOUT, EXPORT, SYNC, BULK_DELETE, BULK_UPDATE
  entity     String   // client, product, installation, invoice, user, settings
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

// ─── Tableau de communication (Board) ───────────────────────────

model BoardColumn {
  id        String      @id @default(cuid())
  name      String
  color     String      @default("#3b82f6")
  position  Int         @default(0)
  cards     BoardCard[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("board_columns")
}

model BoardCard {
  id              String           @id @default(cuid())
  columnId        String
  column          BoardColumn      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  priority        Int              @default(3) // 1=Urgent, 2=Normal, 3=Basse
  position        Int              @default(0)
  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assigneeId      String?
  assigneeIds     String?          // JSON array of user IDs for multiple assignees
  createdById     String?
  dueDate         DateTime?
  links           String?          // JSON array of links
  archived        Boolean          @default(false)
  archivedAt      DateTime?
  movedToColumnAt DateTime         @default(now())
  comments        CardComment[]
  attachments     CardAttachment[]
  tags            CardTagLink[]
  history         CardHistory[]
  checklist       CardChecklistItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([columnId])
  @@index([clientId])
  @@index([contactId])
  @@index([assigneeId])
  @@index([priority])
  @@index([archived])
  @@map("board_cards")
}

model CardComment {
  id        String    @id @default(cuid())
  cardId    String
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  content   String
  createdAt DateTime  @default(now())

  @@index([cardId])
  @@map("card_comments")
}

model CardAttachment {
  id        String    @id @default(cuid())
  cardId    String
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int?
  createdAt DateTime  @default(now())

  @@index([cardId])
  @@map("card_attachments")
}

model CardTag {
  id    String        @id @default(cuid())
  name  String        @unique
  color String        @default("#6b7280")
  cards CardTagLink[]

  @@map("card_tags")
}

model CardTagLink {
  id     String    @id @default(cuid())
  cardId String
  card   BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tagId  String
  tag    CardTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([cardId, tagId])
  @@map("card_tag_links")
}

model CardHistory {
  id        String    @id @default(cuid())
  cardId    String
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  action    String    // CREATE, UPDATE, DELETE, MOVE, COMMENT, ATTACHMENT, ASSIGN
  field     String?   // field name that changed (e.g. "title", "priority", "column")
  oldValue  String?
  newValue  String?
  createdAt DateTime  @default(now())

  @@index([cardId])
  @@index([createdAt])
  @@map("card_history")
}

model CardChecklistItem {
  id        String    @id @default(cuid())
  cardId    String
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text      String
  checked   Boolean   @default(false)
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([cardId])
  @@map("card_checklist_items")
}

model BoardView {
  id        String   @id @default(cuid())
  name      String
  userId    String
  filters   String   // JSON: { search, priority, clientId, assigneeId, tagIds, showArchived }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("board_views")
}

model BoardNote {
  id        String   @id @default(cuid())
  content   String   @default("")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("board_notes")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  type      String?  // card_assigned, card_comment, card_moved, card_archived, card_due, ticket_new, ticket_reply
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  // In-app notification toggles
  cardAssigned       Boolean @default(true)
  cardComment        Boolean @default(true)
  cardMoved          Boolean @default(true)
  cardArchived       Boolean @default(true)
  cardDueDate        Boolean @default(true)
  ticketNew          Boolean @default(true)
  ticketReply        Boolean @default(true)
  backupError        Boolean @default(true)
  securityAlert      Boolean @default(true)
  // Email notification toggles
  emailCardAssigned  Boolean @default(false)
  emailCardComment   Boolean @default(false)
  emailTicketNew     Boolean @default(true)
  emailTicketReply   Boolean @default(true)
  emailBackupError   Boolean @default(true)
  emailSecurityAlert Boolean @default(true)
  // Global toggles
  muteAll            Boolean @default(false)
  emailEnabled       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ─── Knowledge Base ─────────────────────────────────

model KbCategory {
  id       String   @id @default(cuid())
  name     String
  slug     String   @unique
  position Int      @default(0)
  articles KbArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kb_categories")
}

model KbArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @default("")
  categoryId  String?
  category    KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId    String?
  visibility  String   @default("internal") // internal | public | client
  published   Boolean  @default(false)
  clientIds   String?  // JSON array of client IDs for visibility="client"
  attachments KbAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([published])
  @@index([visibility])
  @@map("kb_articles")
}

model KbAttachment {
  id        String   @id @default(cuid())
  articleId String
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int

  createdAt DateTime @default(now())

  @@index([articleId])
  @@map("kb_attachments")
}

// ─── Ticketing System ──────────────────────────────────────

model Ticket {
  id              String          @id @default(cuid())
  ateraId         Int?            @unique
  ticketNumber    String?
  title           String
  description     String
  priority        String          @default("Low")    // Low, Medium, High, Critical
  status          String          @default("Open")   // Open, Pending, Resolved, Closed
  type            String          @default("Incident") // Incident, Problem, Request
  impact          String          @default("NoImpact") // NoImpact, Minor, Major, SiteDown, ServerIssue, Crisis
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientUserId    String?
  clientUser      ClientUser?     @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  assignedTo      String?         // Internal user name
  resolvedAt      DateTime?
  closedAt        DateTime?
  ateraSynced     Boolean         @default(false)
  ateraSyncError  String?
  lastAteraSyncAt DateTime?
  comments        TicketComment[]
  attachments     TicketAttachment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clientId])
  @@index([clientUserId])
  @@index([status])
  @@index([priority])
  @@index([ateraId])
  @@map("tickets")
}

model TicketComment {
  id              String     @id @default(cuid())
  ticketId        String
  ticket          Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content         String
  authorName      String
  authorEmail     String?
  isInternal      Boolean    @default(false)
  isFromClient    Boolean    @default(false)
  ateraCommentId  String?
  createdAt       DateTime   @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

// ─── Calendar ICS Feeds ──────────────────────────────
model CalendarFeed {
  id          String   @id @default(cuid())
  name        String
  url         String
  color       String   @default("#3b82f6")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  visibility  CalendarFeedVisibility[]

  @@map("calendar_feeds")
}

model CalendarFeedVisibility {
  id       String       @id @default(cuid())
  userId   String
  feedId   String
  feed     CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  hidden   Boolean      @default(false)

  @@unique([userId, feedId])
  @@index([userId])
  @@map("calendar_feed_visibility")
}

// ─── Oxibox Backup Snapshots ────────────────────────────

model OxiboxSnapshot {
  id              String    @id @default(cuid())
  organizationId  String
  status          String    // "OK", "ALERT", or "ERROR"
  machineCount    Int       @default(0)
  ongoingBackup   Boolean   @default(false)
  allocatedQuota  BigInt?   // bytes
  currentUsage    BigInt?   // bytes
  date            DateTime  // one snapshot per org per day
  createdAt       DateTime  @default(now())

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
  @@index([status])
  @@map("oxibox_snapshots")
}

// ─── Quota Alert History ────────────────────────────────

model QuotaAlert {
  id              String   @id @default(cuid())
  organizationId  String
  clientName      String?
  alertType       String   // "warning" | "critical" | "exceeded"
  usagePercent    Float
  allocatedQuota  BigInt?
  currentUsage    BigInt?
  recipients      String   // JSON array of email addresses
  sentAt          DateTime @default(now())
  manual          Boolean  @default(false)

  @@index([organizationId])
  @@index([alertType])
  @@index([sentAt])
  @@map("quota_alerts")
}
