generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String           @id @default(cuid())
  name          String
  email         String           @unique
  password      String
  role          Role             @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  passwordResets PasswordReset[]

  @@map("users")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

model Client {
  id              String         @id @default(cuid())
  axonautId       Int?           @unique
  name            String
  email           String?
  phone           String?
  address         String?
  city            String?
  zipCode         String?
  country         String?
  clientType      String?
  logoUrl         String?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  invoices        Invoice[]
  installations   Installation[]
  portalUsers     ClientUser[]
  portalSettings  ClientPortalSettings?

  @@index([deletedAt])
  @@map("clients")
}

model ClientUser {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  email             String    @unique
  password          String    @default("")
  active            Boolean   @default(true)
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clientId])
  @@index([inviteToken])
  @@map("client_users")
}

model ClientPortalSettings {
  id              String  @id @default(cuid())
  clientId        String  @unique
  client          Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  primaryColor    String  @default("#3b82f6")
  headerLogo      String?
  welcomeMessage  String?
  welcomeTitle    String?
  welcomeContent  String?
  showStats       Boolean @default(true)
  showExpiring    Boolean @default(true)
  showFamily      Boolean @default(true)
  showSupplier    Boolean @default(true)
  showDuration    Boolean @default(true)
  showQuantity    Boolean @default(false)
  showComParc     Boolean @default(false)
  footerText      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("client_portal_settings")
}

model Product {
  id              String         @id @default(cuid())
  axonautId       Int?           @unique
  name            String
  code            String?
  description     String?
  family          String?
  supplier        String?
  duration        String?
  durationMonths  Int?
  unitPrice       Float?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  invoiceLines    InvoiceLine[]
  installations   Installation[]

  @@index([deletedAt])
  @@map("products")
}

model Invoice {
  id              String        @id @default(cuid())
  axonautId       Int?          @unique
  invoiceNumber   String?
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  invoiceDate     DateTime
  totalAmount     Float?
  status          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           InvoiceLine[]
  installations   Installation[]

  @@map("invoices")
}

model InvoiceLine {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  description     String?
  quantity        Float         @default(1)
  unitPrice       Float?
  purchasePrice   Float?
  totalPrice      Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("invoice_lines")
}

model Installation {
  id              String             @id @default(cuid())
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id])
  productId       String
  product         Product            @relation(fields: [productId], references: [id])
  invoiceId       String?
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id])
  invoiceLineId   String?            @unique
  supplier        String?
  family          String?
  quantity        Float              @default(1)
  startDate       DateTime
  durationMonths  Int
  endDate         DateTime
  status          String             @default("EN_PARC_GARANTIE")
  alwaysInFleet   Boolean            @default(false)
  comParc         String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  history         InstallationHistory[]

  deletedAt       DateTime?
  @@index([clientId])
  @@index([status])
  @@index([endDate])
  @@index([status, endDate])
  @@index([deletedAt])
  @@map("installations")
}

model InstallationHistory {
  id              String       @id @default(cuid())
  installationId  String
  installation    Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  field           String
  oldValue        String?
  newValue        String?
  changedBy       String?
  createdAt       DateTime     @default(now())

  @@index([installationId])
  @@map("installation_history")
}

model SyncLog {
  id          String   @id @default(cuid())
  type        String
  status      String
  message     String?
  details     String?
  itemCount   Int      @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@map("sync_logs")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String   // CREATE, UPDATE, DELETE, RESTORE, LOGIN, LOGOUT, EXPORT, SYNC, BULK_DELETE, BULK_UPDATE
  entity     String   // client, product, installation, invoice, user, settings
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}
