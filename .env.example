# ============================================================
# COMET — Configuration
# Copier ce fichier en .env et adapter les valeurs
# ============================================================

# --- Base de données PostgreSQL ---
POSTGRES_USER=comet
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=comet_cedelia
DATABASE_URL="postgresql://comet:change-me-use-a-strong-password@db:5432/comet_cedelia?schema=public"

# --- Authentification (obligatoire) ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Mettre true si derrière un reverse proxy (nginx, traefik, caddy)
AUTH_TRUST_HOST=true

# --- Chiffrement des secrets (clés API, mots de passe SMTP) ---
# Générer avec : openssl rand -hex 32
ENCRYPTION_KEY=""

# --- Cron (sauvegardes auto, alertes email) ---
# Générer avec : openssl rand -base64 16
CRON_SECRET="generate-with-openssl-rand-base64-16"

# --- Axonaut API (optionnel) ---
AXONAUT_API_KEY=""
AXONAUT_API_URL="https://axonaut.com/api/v2"

# --- Ports (optionnel, défauts ci-dessous) ---
APP_PORT=3000
DB_PORT=5432

# --- Nom de l'application (affiché dans les emails d'invitation) ---
NEXT_PUBLIC_APP_NAME=Comet

# --- Fuseau horaire ---
TZ=Europe/Paris

# --- Note: SMTP ---
# La configuration email (SMTP) se fait dans l'interface
# Paramètres > Alertes Email, pas besoin de variable d'environnement.
