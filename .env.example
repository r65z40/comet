# Database (required for docker-compose)
POSTGRES_USER=comet
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=comet_cedelia
DATABASE_URL="postgresql://comet:change-me-use-a-strong-password@localhost:5432/comet_cedelia?schema=public"

# NextAuth (required)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Axonaut API (optional)
AXONAUT_API_KEY=""
AXONAUT_API_URL="https://axonaut.com/api/v2"

# SMTP (for invitation emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# App
NEXT_PUBLIC_APP_NAME="COMET CEDELIA"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
